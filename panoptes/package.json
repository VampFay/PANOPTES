{
  "name": "panoptes-core",
  "version": "1.3.1",
  "description": "PANOPTES — deterministic, survivable security mediation for LLM agents. Label-lattice policy engine with immune organs: canary interdiction, injection screening, inert transduction, escrowed authority, cross-session taint ledger.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "panoptes": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/v2.ts",
    "./v1": "./src/core/index.ts",
    "./audit": "./src/audit.ts",
    "./server": "./src/server.ts",
    "./mcp": "./src/mcp.ts"
  },
  "files": [
    "src",
    "tests",
    "corpus",
    "docs",
    "examples",
    "python",
    "tools",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "bunfig.toml"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun run src/cli.ts bench",
    "bench:quick": "bun run src/cli.ts bench --quick",
    "cli": "bun run src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "mcp": "bun run src/cli.ts mcp",
    "redteam": "bun run tools/redteam.ts",
    "py:test": "python3 -m unittest discover -s python/tests -v"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "llm-agents",
    "security",
    "guardrails",
    "deterministic",
    "information-flow",
    "label-lattice",
    "prompt-injection",
    "mcp"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.6.0"
  }
}
